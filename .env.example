# Cloudflare Worker URL for this app (no trailing slash)
VITE_API_URL=https://brilliancy-appointments-api.YOUR-SUBDOMAIN.workers.dev
# Same Supabase project as the attendance app (publishable key only; never the secret key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Optional: Cloudflare Turnstile site key (pair with TURNSTILE_SECRET_KEY on the Worker)
VITE_TURNSTILE_SITE_KEY=
